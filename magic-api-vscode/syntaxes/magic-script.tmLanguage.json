{
  "scopeName": "source.magic-script",
  "name": "Magic Script",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.magic-script",
          "match": "//.*$"
        },
        {
          "name": "comment.block.magic-script",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.magic-script",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.magic-script",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.magic-script",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.magic-script",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.magic-script",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.magic-script",
          "match": "\\b(if|else|for|while|return|break|continue|try|catch|finally|throw|async|await|import|as|new|var|let|const|in|null|true|false)\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.language.magic-script",
          "match": "\\b(db|http|request|response|env|log|header|cookie|session|path|body)\\b"
        }
      ]
    }
  }
}
