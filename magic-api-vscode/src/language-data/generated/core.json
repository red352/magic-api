  "modules": {
    "db": {
      "detail": "默认数据库模块",
      "documentation": "magic-api 默认导入的数据库模块。",
      "methods": [
        {
          "label": "select",
          "signature": "db.select(sql)",
          "detail": "查询多行",
          "documentation": "执行查询并返回多行数据。",
          "example": "db.select(\"\"\"\nselect * from sys_user where status = #{status}\n\"\"\")",
          "parameters": [
            "sql"
          ]
        },
        {
          "label": "selectInt",
          "signature": "db.selectInt(sql)",
          "detail": "查询整数",
          "documentation": "执行查询并返回整数。",
          "parameters": [
            "sql"
          ]
        },
        {
          "label": "selectOne",
          "signature": "db.selectOne(sql)",
          "detail": "查询单行",
          "documentation": "执行查询并返回一行数据。",
          "example": "db.selectOne(\"\"\"\nselect * from sys_user where id = #{id}\n\"\"\")",
          "parameters": [
            "sql"
          ]
        },
        {
          "label": "selectValue",
          "signature": "db.selectValue(sql)",
          "detail": "查询单值",
          "documentation": "执行查询并返回单个值。",
          "parameters": [
            "sql"
          ]
        },
        {
          "label": "page",
          "signature": "db.page(sql, limit?, offset?)",
          "detail": "分页查询",
          "documentation": "执行分页查询。",
          "example": "db.page(\"\"\"\nselect * from sys_user where 1 = 1\n\"\"\")",
          "parameters": [
            "sql",
            "limit",
            "offset"
          ]
        },
        {
          "label": "update",
          "signature": "db.update(sql)",
          "detail": "更新 SQL",
          "documentation": "执行 insert/update/delete SQL 并返回影响行数。",
          "example": "db.update(\"\"\"\nupdate sys_user set name = #{name} where id = #{id}\n\"\"\")",
          "parameters": [
            "sql"
          ]
        },
        {
          "label": "insert",
          "signature": "db.insert(sql, id?)",
          "detail": "插入 SQL",
          "documentation": "执行 insert SQL，可返回主键。",
          "parameters": [
            "sql",
            "id"
          ]
        },
        {
          "label": "call",
          "signature": "db.call(sql)",
          "detail": "调用存储过程",
          "documentation": "执行存储过程调用。",
          "parameters": [
            "sql"
          ]
        },
        {
          "label": "batchUpdate",
          "signature": "db.batchUpdate(sql, batchArgs)",
          "detail": "批量更新",
          "documentation": "执行批量更新。",
          "parameters": [
            "sql",
            "batchArgs"
          ]
        },
        {
          "label": "cache",
          "signature": "db.cache(cacheName, ttl?)",
          "detail": "查询缓存",
          "documentation": "开启链式查询缓存。",
          "parameters": [
            "cacheName",
            "ttl"
          ]
        },
        {
          "label": "deleteCache",
          "signature": "db.deleteCache(cacheName)",
          "detail": "删除缓存",
          "documentation": "删除指定缓存。",
          "parameters": [
            "cacheName"
          ]
        },
        {
          "label": "transaction",
          "signature": "db.transaction(callback?)",
          "detail": "事务",
          "documentation": "在事务中执行回调或返回事务对象。",
          "example": "db.transaction(() => {\n  db.update(sql)\n  return db.selectOne(querySql)\n})",
          "parameters": [
            "callback"
          ]
        }
      ]
    },
